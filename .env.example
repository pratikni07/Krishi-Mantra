# Copy to .env at the repo root (alongside docker-compose.iot.yml) and
# fill with real values. .env is gitignored; .env.example is safe to
# commit.

# --- MQTT broker auth -------------------------------------------------
# Seed these usernames into mosquitto/config/passwd with
# `mosquitto_passwd` before first boot. Matching ACL entries must also
# be present in mosquitto/config/acl (see acl.example).
MQTT_DEVICE_USERNAME=krishi-device
MQTT_DEVICE_PASSWORD=change-me
MQTT_CONSUMER_USERNAME=krishi-consumer
MQTT_CONSUMER_PASSWORD=change-me
