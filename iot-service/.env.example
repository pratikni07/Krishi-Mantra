# Application type - determines which service to run
# Options: device, parser, soil, weather
APP_TYPE=parser

# MQTT Configuration
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=krishi-mantra-iot

# ClickHouse Configuration
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=krishi_mantra
CLICKHOUSE_USER=default
CLICKHOUSE_PASS=

# Device Simulator Configuration (only used when APP_TYPE=device)
DEVICE_ID=device-001
SENSOR_INTERVAL=10
