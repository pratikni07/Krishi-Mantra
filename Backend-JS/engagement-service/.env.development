# Server Configuration
PORT=3007
NODE_ENV=development

# MongoDB Configuration - Optimized for 100k users
MONGODB_URI=mongodb://admin:secure-password@192.168.1.39:27018/engagementdb?authSource=admin
MONGODB_MAX_POOL_SIZE=150
MONGODB_MIN_POOL_SIZE=30

# Redis Configuration - For caching and real-time counters
REDIS_HOST=192.168.1.39
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_KEY_PREFIX=engagement:
REDIS_TTL=3600

# RabbitMQ Configuration - For async event processing
RABBITMQ_URL=amqp://guest:guest@192.168.1.39:5673
RABBITMQ_EVENT_QUEUE=engagement_events
RABBITMQ_BATCH_QUEUE=engagement_batch
RABBITMQ_PREFETCH=10

# Event Processing Configuration
BATCH_SIZE=1000
BATCH_INTERVAL_MS=5000
EVENT_TTL_DAYS=90

# Rate Limiting - Optimized for high traffic
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_TRACK_MAX=1000

# Analytics Configuration
AGGREGATION_INTERVAL_MS=60000
REALTIME_UPDATE_INTERVAL_MS=5000
SESSION_TIMEOUT_MS=1800000

# Security
JWT_SECRET=shreemant
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
