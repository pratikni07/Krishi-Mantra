# Environment
NODE_ENV=development|production
PORT=3002

# Database Configuration
MONGODB_URL=mongodb://your-mongodb-url/database-name

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-password

# Security
