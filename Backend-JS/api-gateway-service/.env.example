# Development Environment
NODE_ENV=development
PORT=3001

# Service URLs (local development) - ensure no trailing slashes
MAIN_SERVICE_URL=http://localhost:3002
MESSAGE_SERVICE_URL=http://localhost:3004
FEED_SERVICE_URL=http://localhost:3003
REEL_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006
ENGAGEMENT_SERVICE_URL=http://localhost:3007

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info  # Options: error, warn, info, debug

# AWS CREDENTIALS - IMPORTANT: DO NOT COMMIT REAL CREDENTIALS
# Replace with your own AWS credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_bucket_name
AWS_CLOUDFRONT_DOMAIN=https://your-cloudfront-domain.cloudfront.net
