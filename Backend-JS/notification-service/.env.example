# Environment
NODE_ENV=development|production
PORT=3006

# Database Configuration
MONGODB_URI=mongodb://your-mongodb-url/notification-database

# Redis Configuration
REDIS_HOST=192.168.1.39
REDIS_PORT=6380
REDIS_PASSWORD=your-redis-password

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@192.168.1.39:5673
RABBITMQ_NOTIFICATION_QUEUE=notifications
RABBITMQ_BATCH_QUEUE=notification_batches
RABBITMQ_EVENT_QUEUE=notification_events
RABBITMQ_EVENT_EXCHANGE=notification.events

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Batch Processing Configuration
BATCH_SIZE=100
BATCH_INTERVAL_MS=60000
DIGEST_FLUSH_INTERVAL_MS=300000

# Push Notification Configuration (optional)
WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_CONTACT_EMAIL=your-email@example.com

# OneSignal Configuration (optional)
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-api-key

# Email Configuration (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=notifications@example.com

# SMS Configuration (optional)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AWS CREDENTIALS
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=krishi-mantra
AWS_CLOUDFRONT_DOMAIN=https://d1fgmpk5nnkfcj.cloudfront.net
