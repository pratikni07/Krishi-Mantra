# Environment
NODE_ENV=development|production
PORT=3004

# Database Configuration
MONGODB_URI=mongodb://your-mongodb-url/message-database

# Redis Configuration
REDIS_HOST=192.168.1.39
REDIS_PORT=6380
REDIS_PASSWORD=your-redis-password

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# AI Service Configuration (for AI chat features)
AI_API_URL=https://your-ai-service-url
AI_API_KEY=your-ai-api-key

# Cloudinary Configuration (for media messages)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
