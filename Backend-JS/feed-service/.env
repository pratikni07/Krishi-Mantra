# Server Configuration
PORT=3005
NODE_ENV=development
# MongoDB Configuration
MONGODB_URI=mongodb://admin:secure-password@10.33.209.124:27018/feeddb?authSource=admin
# JWT Configuration
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=1d

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis Configuration
REDIS_HOST=10.33.209.124
REDIS_PORT=6380
# Leave password empty for localhost dev without auth
# For production: REDIS_PASSWORD=your-redis-password
REDIS_PASSWORD=

# Email Service (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# Additional Security
CORS_ORIGIN=http://localhost:3001
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX_REQUESTS=100

# Optional Debugging
DEBUG=true

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=krishi-mantra
